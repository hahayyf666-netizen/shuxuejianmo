{
  "contract_version": "q3-v1-preflight-2026-09-25",
  "feature_version": "aligned_50",
  "text_representation": "text",
  "feature_dims": {"text": 768, "audio": 74, "vision": 35},
  "max_positions": 50,
  "content_positions": "attention_prefix_excluding_verified_CLS_101_and_SEP_102",
  "train_split": "attachment2/train",
  "selection_split": "attachment2/valid",
  "test_policy": "locked_until_model_and_explanation_protocol_freeze",
  "attachment4_policy": "no_formal_inference_in_preflight",
  "candidate_models": ["B0", "B1"],
  "projection_dim": 64,
  "b1_bigru_hidden_per_direction": 32,
  "dropout": 0.2,
  "loss": "cross_entropy_logits + 1.0 * MAE",
  "optimizer": "AdamW",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 32,
  "max_epochs": 60,
  "gradient_clip_norm": 1.0,
  "early_stopping_patience": 8,
  "early_stopping_reset_delta": 0.0001,
  "selection_score": "0.5*(1-MacroF1_valid)+0.5*(MAE_valid/6)",
  "architecture_seeds": [2029, 2030, 2031],
  "delivery_seed": 2029,
  "architecture_tie_tolerance": 0.0001,
  "shapley_reference": "train_valid_content_position_feature_mean",
  "shapley_players": ["text", "audio", "vision"],
  "classification_explanation_target": "full_input_predicted_class_probability_fixed_across_coalitions",
  "regression_explanation_target": "bounded_regression_output",
  "ig_quadrature": "Gauss-Legendre",
  "ig_steps_schedule": [64, 128, 256],
  "ig_completeness_atol": 0.001,
  "ig_completeness_rtol": 0.01,
  "attribution_epsilon_candidate": 0.000001,
  "explanation_subset_rule": "first_120_valid_by_SHA256(q3-xai-v1|sample_id)",
  "explanation_perturbation_fractions": [0.1, 0.2, 0.3],
  "random_controls_per_case": 50,
  "attachment4_card_rule": "normal_samples_first_by_SHA256(q3-card-v1|sample_id), count_frozen_before_formal_inference",
  "mapping_policy": "fail_closed_no_uniform_index_to_seconds",
  "mapping_statuses": ["verified_text", "verified_time", "index_only", "unavailable"]
}
